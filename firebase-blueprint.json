{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public student profile information visible to campus peers.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the student.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Student display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "hostelArea": {
          "type": "string",
          "description": "General campus area such as DBS Boys Hostel or Selaqui.",
          "minLength": 1,
          "maxLength": 80
        },
        "courseLabel": {
          "type": "string",
          "description": "Student program or role label.",
          "minLength": 1,
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was last updated."
        }
      },
      "required": ["uid", "displayName", "hostelArea", "courseLabel", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Private student PII including email, phone, and exact hostel room or PG address.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email address.",
          "minLength": 3,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "description": "Student mobile number for gate alerts.",
          "minLength": 7,
          "maxLength": 20
        },
        "hostelAddress": {
          "type": "string",
          "description": "Exact hostel block, room, or PG address.",
          "minLength": 2,
          "maxLength": 140
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of update."
        }
      },
      "required": ["uid", "email", "phone", "hostelAddress", "createdAt", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "A student service booking order owned by an authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "bookingCode": {
          "type": "string",
          "description": "Human-readable booking reference such as CE-1043.",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "hostelAddress": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "phone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 20
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["UPI", "Hostel Gate COD"]
        },
        "promoCode": {
          "type": "string",
          "maxLength": 40
        },
        "subtotalInr": {
          "type": "number"
        },
        "discountInr": {
          "type": "number"
        },
        "totalInr": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["Confirmed", "In Progress", "Completed", "Cancelled"]
        },
        "estimatedFulfillment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summaryLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "itemCount": {
          "type": "number"
        },
        "pointsEarned": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "bookingCode",
        "studentName",
        "hostelAddress",
        "phone",
        "paymentMethod",
        "subtotalInr",
        "discountInr",
        "totalInr",
        "status",
        "estimatedFulfillment",
        "summaryLabel",
        "itemCount",
        "pointsEarned",
        "createdAt",
        "updatedAt"
      ]
    },
    "BookingItem": {
      "title": "BookingItem",
      "description": "A single booked service package line item under a parent Booking document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "enum": ["Food", "Laundry", "Printing", "Transport", "Stationery"]
        },
        "packageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "packageName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "unitPriceInr": {
          "type": "number"
        },
        "unitLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "quantity": {
          "type": "number"
        },
        "timeSlot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "serviceId",
        "serviceName",
        "category",
        "packageId",
        "packageName",
        "unitPriceInr",
        "unitLabel",
        "quantity",
        "timeSlot",
        "createdAt"
      ]
    },
    "LoyaltyLedgerEntry": {
      "title": "LoyaltyLedgerEntry",
      "description": "Immutable points ledger entry for a user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "pointsDelta": {
          "type": "number"
        },
        "bookingId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "label", "pointsDelta", "createdAt"]
    },
    "RedeemedVoucher": {
      "title": "RedeemedVoucher",
      "description": "A loyalty voucher redeemed by the student and usable once at checkout.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tierId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "discountInr": {
          "type": "number"
        },
        "pointsSpent": {
          "type": "number"
        },
        "usedInBookingId": {
          "type": "string",
          "maxLength": 128
        },
        "redeemedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "code",
        "tierId",
        "title",
        "discountInr",
        "pointsSpent",
        "usedInBookingId",
        "redeemedAt"
      ]
    },
    "ServiceReview": {
      "title": "ServiceReview",
      "description": "A verified student review submitted for a completed booking.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "bookingCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "hostelArea": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "rating": {
          "type": "number"
        },
        "comment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "serviceId",
        "bookingCode",
        "studentName",
        "hostelArea",
        "rating",
        "comment",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/public/profile": {
      "schema": {
        "$ref": "#/entities/UserPublicProfile"
      },
      "description": "Public student profile document."
    },
    "/users/{userId}/private/info": {
      "schema": {
        "$ref": "#/entities/UserPrivateInfo"
      },
      "description": "Private PII document strictly accessible only by the owner."
    },
    "/bookings/{bookingId}": {
      "schema": {
        "$ref": "#/entities/Booking"
      },
      "description": "Student service bookings owned by the authenticated user."
    },
    "/bookings/{bookingId}/items/{itemId}": {
      "schema": {
        "$ref": "#/entities/BookingItem"
      },
      "description": "Line items belonging to a parent booking."
    },
    "/users/{userId}/loyaltyLedger/{entryId}": {
      "schema": {
        "$ref": "#/entities/LoyaltyLedgerEntry"
      },
      "description": "Immutable loyalty points transaction ledger per user."
    },
    "/users/{userId}/vouchers/{voucherId}": {
      "schema": {
        "$ref": "#/entities/RedeemedVoucher"
      },
      "description": "Redeemed student reward vouchers per user."
    },
    "/reviews/{reviewId}": {
      "schema": {
        "$ref": "#/entities/ServiceReview"
      },
      "description": "Verified student reviews submitted from completed bookings."
    }
  }
}
